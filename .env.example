# ============================================
# Template .env - Azka Laundry
# Copy file ini jadi ".env" lalu isi nilainya sendiri.
# JANGAN commit file ".env" ke git (sudah ada di .gitignore).
# ============================================

# ── Database (MySQL) ──
# Default di bawah ini sudah cocok untuk XAMPP lokal (DB_PASS kosong).
DB_HOST=localhost
DB_NAME=azka_laundry
DB_USER=root
DB_PASS=
DB_CHAR=utf8mb4

# ── Meta WhatsApp Cloud API (Notifikasi WhatsApp) ──
# META_WA_TOKEN           : Access Token PERMANEN dari System User.
#                           Meta Developer > App > WhatsApp > Penyiapan Produksi > "Buat token"
# META_WA_PHONE_NUMBER_ID : "ID Nomor Telepon" nomor WA Business yang sudah terverifikasi
#                           (kelihatan di halaman yang sama, di sebelah nomor telepon)
# META_WA_API_VERSION     : boleh dikosongkan, default v21.0
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v21.0

# Dipakai cron_notif_terlambat.php kalau diakses lewat URL/webcron (bukan PHP CLI).
# Isi dengan string acak sendiri, mis. bin2hex(random_bytes(24)) lewat `php -a`.
CRON_SECRET=

# ── Invoice PDF publik (dilampirkan di notifikasi WA "pesanan selesai") ──
# APP_URL              : OPSIONAL. Domain publik aplikasi TANPA trailing
#                         slash. Kalau dikosongkan (default), otomatis
#                         dideteksi dari domain yang dipakai mengakses
#                         dashboard -- isi manual di sini HANYA kalau
#                         auto-deteksinya ternyata salah.
# INVOICE_LINK_SECRET  : string acak sendiri (boleh generate lewat
#                         bin2hex(random_bytes(24)) di php -a), dipakai
#                         menandatangani link invoice supaya tidak bisa
#                         ditebak-tebak nomor notanya. WAJIB diisi sendiri.
APP_URL=
INVOICE_LINK_SECRET=
